# 静态资源长期缓存：图片/视频名字不变就永不过期，回访不再走网络
/covers/*
  Cache-Control: public, max-age=31536000, immutable

/games/*/cover.webp
  Cache-Control: public, max-age=31536000, immutable

/games/*/cover.jpg
  Cache-Control: public, max-age=31536000, immutable

/games/*/shot-1.jpg
  Cache-Control: public, max-age=31536000, immutable

/games/*/shot-2.jpg
  Cache-Control: public, max-age=31536000, immutable

/games/*/preview.mp4
  Cache-Control: public, max-age=31536000, immutable

/img/*
  Cache-Control: public, max-age=31536000, immutable

# 页面本体每次回源校验，保证改版后立刻可见
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

# 接口绝不缓存
/api/*
  Cache-Control: no-store
